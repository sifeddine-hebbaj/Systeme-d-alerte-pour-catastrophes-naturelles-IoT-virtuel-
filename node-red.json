    {
        "id": "225e42c94e9b167d",
        "type": "function",
        "z": "b71dc3bc831b2fa1",
        "name": "function 4",
        "func": "let dataPoints = msg.payload[0].data[0];\nlet lastPoint = dataPoints[dataPoints.length - 1];\nif (!lastPoint || typeof lastPoint.y !== \"number\") return null;\n\nlet value = lastPoint.y;\nlet lastSent = context.get('lastSent') || 0;\nlet now = Date.now();\n\nif (value > 80 && (now - lastSent > 5000)) {\n  context.set('lastSent', now);\n\n  let level = \"\", recommendation = \"\", color = \"\";\n  if (value > 95) {\n    level = \"CRITICAL\"; color = \"#c0392b\";\n    recommendation = \"🚨 Evacuate immediately and contact emergency services.\";\n  } else if (value > 85) {\n    level = \"HIGH\"; color = \"#e67e22\";\n    recommendation = \"⚠️ Prepare for flooding and monitor closely.\";\n  } else {\n    level = \"WARNING\"; color = \"#f1c40f\";\n    recommendation = \"ℹ️ Stay alert and keep monitoring.\";\n  }\n\n  msg.topic = \"Water Level Alert - \" + level;\n\n  // ✅ HTML as string\n  msg.payload = `\n<div style=\"font-family:Arial; background:#f4f6f7; padding:20px;\">\n  <div style=\"max-width:600px;margin:auto;background:white;padding:20px;border-radius:8px;\">\n    <h2 style=\"color:${color};text-align:center;\">🚨 Water Level Alert</h2>\n    <p><b>Level:</b> <span style=\"color:${color};\">${level}</span></p>\n    <p><b>Value:</b> ${value.toFixed(2)}</p>\n    <div style=\"background:#fdf2e9;padding:10px;border-left:5px solid ${color};\">\n      ${recommendation}\n    </div>\n    <p style=\"font-size:12px;color:gray;text-align:center;\">\n      IoT Flood Alert System\n    </p>\n  </div>\n</div>\n`;\n\n  return msg;\n}\n\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1040,
        "y": 100,
        "wires": [
            [
                "ffb31850520d3386"
            ]
        ]
    },
    {
        "id": "f94501e4366f3222",
        "type": "function",
        "z": "b71dc3bc831b2fa1",
        "name": "function 5",
        "func": "let dataPoints = msg.payload[0].data[0];\nlet lastPoint = dataPoints[dataPoints.length - 1];\n\n// value from last data point\nlet value = lastPoint.y;\nif (typeof value !== \"number\") return null; // safety check\n\n// limiter: 8 seconds\nlet lastSent = context.get('lastSentFlood') || 0;\nlet now = Date.now();\n\nif (value > 40 && (now - lastSent > 8000)) { // >40, every 8s max\n  context.set('lastSentFlood', now);\n\n  let level = \"\";\n  let recommendation = \"\";\n  let color = \"\";\n\n  if (value > 60) {\n    level = \"CRITICAL\";\n    color = \"#c0392b\";\n    recommendation = \"🚨 Flood level critical! Evacuate immediately!\";\n  } else if (value > 50) {\n    level = \"HIGH\";\n    color = \"#e67e22\";\n    recommendation = \"⚠️ High flood level! Prepare and monitor closely.\";\n  } else {\n    level = \"WARNING\";\n    color = \"#f1c40f\";\n    recommendation = \"ℹ️ Flood warning. Stay alert.\";\n  }\n\n  msg.topic = \"Flood Alert - \" + level;\n\n  // HTML email as string\n  msg.payload = `\n<div style=\"font-family:Arial; background:#f4f6f7; padding:20px;\">\n  <div style=\"max-width:600px;margin:auto;background:white;padding:20px;border-radius:8px;\">\n    <h2 style=\"color:${color}; text-align:center;\">🚨 Flood Alert</h2>\n    <p><b>Level:</b> <span style=\"color:${color};\">${level}</span></p>\n    <p><b>Measured Flood Value:</b> ${value.toFixed(2)}</p>\n    <div style=\"background:#fdf2e9;padding:10px;border-left:5px solid ${color};\">\n      ${recommendation}\n    </div>\n    <p style=\"font-size:12px;color:gray;text-align:center;\">\n      IoT Flood Alert System\n    </p>\n  </div>\n</div>\n`;\n\n  return msg;\n}\n\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
