    {
        "id": "e34ccd70e552f78e",
        "type": "function",
        "z": "b71dc3bc831b2fa1",
        "name": "function 6",
        "func": "let dataPoints = msg.payload[0].data[0];\nlet lastPoint = dataPoints[dataPoints.length - 1];\n\n// value from last data point\nlet value = lastPoint.y;\nif (typeof value !== \"number\") return null; // safety check\n\n// limiter: 7 seconds\nlet lastSentFire = context.get('lastSentFire') || 0;\nlet now = Date.now();\n\nif (value >= 1 && (now - lastSentFire > 7000)) { // fire detected\n    context.set('lastSentFire', now);\n\n    let level = \"\";\n    let recommendation = \"\";\n    let color = \"\";\n\n    if (value >= 5) {\n        level = \"CRITICAL\";\n        color = \"#c0392b\";\n        recommendation = \"🔥 Fire detected! Evacuate immediately and call emergency services!\";\n    } else {\n        level = \"WARNING\";\n        color = \"#e67e22\";\n        recommendation = \"⚠️ Fire detected! Stay alert and monitor the situation.\";\n    }\n\n    msg.topic = \"Fire Alert - \" + level;\n\n    // HTML email as string\n    msg.payload = `\n<div style=\"font-family:Arial; background:#f4f6f7; padding:20px;\">\n  <div style=\"max-width:600px;margin:auto;background:white;padding:20px;border-radius:8px;\">\n    <h2 style=\"color:${color}; text-align:center;\">🔥 Fire Alert</h2>\n    <p><b>Level:</b> <span style=\"color:${color};\">${level}</span></p>\n    <p><b>Fire Value:</b> ${value.toFixed(2)}</p>\n    <div style=\"background:#fdf2e9;padding:10px;border-left:5px solid ${color};\">\n      ${recommendation}\n    </div>\n    <p style=\"font-size:12px;color:gray;text-align:center;\">\n      IoT Fire Alert System\n    </p>\n  </div>\n</div>\n`;\n\n    return msg;\n}\n\nreturn null;\n",
