    {
        "id": "225e42c94e9b167d",
        "type": "function",
        "z": "b71dc3bc831b2fa1",
        "name": "function 4",
        "func": "// get last sent timestamp\nlet lastSent = context.get('lastSent') || 0;\nlet now = Date.now();\n\n// limiter message every 6 seconds\nif (now - lastSent > 6000) { // 6000 ms = 6 sec\n    context.set('lastSent', now);\n    msg.topic = \"Alert\";\n    msg.payload = \"Alert water\";\n    msg.className = \"red\";\n    return msg;\n}\n\nreturn null; // ignore message\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
